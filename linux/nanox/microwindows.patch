+
+/* Takes e out of rectangle r (left, top, right, bottom) on the side that leaves most of it
+ * with point p still inside; nothing is left if p is in e. */
+static void
+quiet_cut(const int *p, int *r, int ex0, int ey0, int ex1, int ey1)
+{
+	int side = -1, best = 0, area, w = r[2] - r[0], h = r[3] - r[1];
+
+	if (ex0 >= r[2] || ex1 <= r[0] || ey0 >= r[3] || ey1 <= r[1] || w <= 0 || h <= 0)
+		return;
+	if (ex1 <= p[0] && (area = (r[2] - ex1) * h) > best)
+		best = area, side = 0;
+	if (ey1 <= p[1] && (area = w * (r[3] - ey1)) > best)
+		best = area, side = 1;
+	if (ex0 > p[0] && (area = (ex0 - r[0]) * h) > best)
+		best = area, side = 2;
+	if (ey0 > p[1] && (area = w * (ey0 - r[1])) > best)
+		best = area, side = 3;
+	if (side < 0)
+		r[2] = r[0];
+	else
+		r[side] = side == 0 ? ex1 : side == 1 ? ey1 : side == 2 ? ex0 : ey0;
+}
