+		if (wp->clipregion)
+			return 0;
+#endif
+		/* inside the window, and outside every window that lies over it */
+		if (r[0] < wp->x) r[0] = wp->x;
+		if (r[1] < wp->y) r[1] = wp->y;
+		if (r[2] > wp->x + wp->width) r[2] = wp->x + wp->width;
+		if (r[3] > wp->y + wp->height) r[3] = wp->y + wp->height;
+		for (sp = wp->parent->children; sp && sp != wp; sp = sp->siblings)
+			if (sp->realized)
+				quiet_cut(p, r, sp->x, sp->y, sp->x + sp->width, sp->y + sp->height);
+	}
+	if (r[2] <= r[0] || r[3] <= r[1])
+		return 0;
+	*x0 = r[0];
+	*y0 = r[1];
+	*x1 = r[2];
+	*y1 = r[3];
+	return 1;
+}
