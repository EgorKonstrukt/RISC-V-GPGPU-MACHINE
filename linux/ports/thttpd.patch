+		status = 302;
+	    if ( ( cp = strstr( headers, "Status:" ) ) != (char*) 0 && cp < br && ( cp == headers || cp[-1] == '\012' ) )
+		status = atoi( cp + 7 + strspn( cp + 7, " \t" ) );
+	    (void) my_snprintf( obuf, sizeof(obuf), "HTTP/1.0 %d %s\015\012", status, status_title( status ) );
+	    (void) httpd_write_fully( STDOUT_FILENO, obuf, strlen( obuf ) );
+	    (void) httpd_write_fully( STDOUT_FILENO, headers, hlen );
+	    hdone = 1;
+	    }
+	}
+    if ( parse )
+	(void) shutdown( STDOUT_FILENO, SHUT_WR );
+    (void) waitpid( pid, (int*) 0, 0 );
+    return 0;
+    }
