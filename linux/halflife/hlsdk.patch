+#if XASH_SHADEREMU
+	int w = older[h];
+	kept[h][w].model = pmodel, kept[h][w].label = label, kept[h][w].seq = -1, kept[h][w].length = pstudiohdr->length, older[h] = !w;
+#endif
 	return -1;
 }
 
