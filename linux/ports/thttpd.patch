+	{
+	k = 0;
+	if ( in[1] >= 0 )
+	    {
+	    if ( ilen > ioff )
+		{ p[k].fd = in[1]; p[k].events = POLLOUT; }
+	    else
+		{ p[k].fd = src; p[k].events = POLLIN; }
+	    ++k;
+	    }
+	if ( out[0] >= 0 )
+	    {
+	    p[k].fd = out[0];
+	    p[k].events = POLLIN;
+	    ++k;
+	    }
