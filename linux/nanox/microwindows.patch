+GsQuietRect(MWCOORD *x0, MWCOORD *y0, MWCOORD *x1, MWCOORD *y1)
+{
+	int p[2] = { cursorx, cursory }, r[4] = { 0, 0, rootwp->width, rootwp->height };
+	GR_EVENT_CLIENT *ecp;
+	GR_WINDOW *wp, *sp;
+
+	if (curbuttons && quiet_dragging && gd_compositor->dragged(x0, y0)) {
+		/* the frame follows the pointer by itself until the button is let go */
+		*x0 = *y0 = 0;
+		*x1 = *y1 = 32767;
+		return 1;
+	}
+	if (!curbuttons)
+		quiet_dragging = 0;
+	if (curbuttons || grabbuttonwp || screensaver_delay)
+		return 0;
+	/* who hears of a move, from the pointer's window up: the usual way out */
+	for (wp = mousewp; ; wp = wp->parent) {
+		for (ecp = wp->eventclients; ecp; ecp = ecp->next)
+			if (ecp->eventmask & (GR_EVENT_MASK_MOUSE_MOTION | GR_EVENT_MASK_MOUSE_POSITION)) {
+				win *frame = wm_find_window(wp->id);
+
+				/* a frame hears of moves for its corner alone (wm_container_mousemoved) */
+				if (!frame || frame->type != WINDOW_TYPE_CONTAINER || frame->active || frame->sizing)
+					return 0;
+				quiet_cut(p, r, wp->x + wp->width - 5, wp->y + wp->height - 5, wp->x + wp->width,
+					wp->y + wp->height);
+			}
