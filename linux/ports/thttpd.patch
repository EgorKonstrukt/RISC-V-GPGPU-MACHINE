+		r = read( src, ibuf, src == 3 ? sizeof(ibuf) : rest < (long long) sizeof(ibuf) ? (int) rest : sizeof(ibuf) );
+		if ( r > 0 )
+		    {
+		    ilen = r;
+		    ioff = 0;
+		    if ( src != 3 )
+			rest -= r;
+		    }
+		else if ( src == 3 )
+		    src = STDIN_FILENO;
+		else
+		    src = -1;
+		}
+	    if ( ilen == ioff && ( src < 0 || ( src == STDIN_FILENO && rest <= 0 ) ) )
+		{
+		(void) close( in[1] );
+		in[1] = -1;
+		}
+	    ++k;
+	    }
+	if ( out[0] >= 0 && p[k].revents )
+	    {
+	    r = read( out[0], obuf, sizeof(obuf) );
+	    if ( r <= 0 )
+		{
+		(void) close( out[0] );
+		out[0] = -1;
+		}
+	    if ( hdone || r <= 0 )
+		{
+		if ( r > 0 )
+		    (void) httpd_write_fully( STDOUT_FILENO, obuf, r );
+		if ( hdone || hlen == 0 )
+		    continue;
+		}
+	    else
+		{
+		httpd_realloc_str( &headers, &hsize, hlen + r );
+		(void) memmove( &headers[hlen], obuf, r );
+		hlen += r;
+		headers[hlen] = '\0';
+		if ( strstr( headers, "\015\012\015\012" ) == (char*) 0 && strstr( headers, "\012\012" ) == (char*) 0 )
+		    continue;
+		}
+	    /* the headers are in (or the output ended): the status line first, as cgi_interpose_output() */
+	    br = strstr( headers, "\015\012\015\012" );
+	    if ( br == (char*) 0 )
+		br = strstr( headers, "\012\012" );
+	    if ( br == (char*) 0 )
+		br = &headers[hlen];
+	    status = 200;
+	    if ( strncmp( headers, "HTTP/", 5 ) == 0 )
+		status = atoi( headers + strcspn( headers, " \t" ) );
