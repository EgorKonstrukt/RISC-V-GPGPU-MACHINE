+
+bool CStudioModelRenderer::StudioBonesAhead( cl_entity_t *e, int core, double clTime, double clOldTime,
+	float bones[][3][4], float lights[][3][4], float rotation[3][4], float *prevframe )
+{
+	studiohdr_t *hdr = e->model && e->model->type == mod_studio ? (studiohdr_t *)e->model->cache.data : NULL;
+
+	if( !hdr || !hdr->numbodyparts || e->curstate.sequence >= hdr->numseq || e->curstate.renderfx != kRenderFxNone
+		|| e->curstate.movetype == MOVETYPE_FOLLOW || e->player )
+		return false;
+	// the sequences it reads: their groups loaded (StudioGetAnim loads them on this core)
+	int seqs[2] = { e->curstate.sequence, e->latched.prevsequence };
+	cache_user_t *groups = (cache_user_t *)e->model->submodels;
+	for( int i = 0; i < 2; i++ )
+	{
+		if( seqs[i] >= hdr->numseq )
+			continue;
+		mstudioseqdesc_t *d = (mstudioseqdesc_t *)( (byte *)hdr + hdr->seqindex ) + seqs[i];
+		if( d->seqgroup && ( !groups || !groups[d->seqgroup].data ))
+			return false;
+	}
+	m_pCurrentEntity = e;
+	m_pRenderModel = e->model;
+	m_pStudioHeader = hdr;
+	m_pPlayerInfo = NULL;
+	m_clTime = clTime, m_clOldTime = clOldTime;
+	m_protationmatrix = (float (*)[3][4])rotation;
+	m_pbonetransform = (float (*)[MAXSTUDIOBONES][3][4])bones;
+	m_plighttransform = (float (*)[MAXSTUDIOBONES][3][4])lights;
+	m_pAheadFrame = prevframe;
+	m_nAheadCore = core;
+	StudioSetUpTransform( 0 );
+	StudioSetupBones();
+	return true;
+}
+#endif
