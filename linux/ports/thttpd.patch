+/* No MMU: thttpd cannot fork a CGI's child, which ran on after fork(). The CGI is run by
+** thttpd started again (thttpd -H REST PARSE BINARY ARGV...), with the connection on 0 and 1
+** and on 3 the POST data already read: it feeds the CGI REST more bytes and parses its headers.
+*/
+#include <poll.h>
+#include <sys/wait.h>
+
+int httpd_self_fd = -1;
