+/* The frame follows the pointer from here on without the window system, the pointer xoff,
+ * yoff inside it (wid 0: no longer). 0: the screen driver cannot, and it is moved as before. */
+int
+GsDragWindow(GR_WINDOW_ID wid, int xoff, int yoff)
+{
+	GR_WINDOW *wp = wid ? GsFindWindow(wid) : NULL;
+
+	gd_scene_gen++;
+	quiet_dragging = 0;
+	if (!gd_compositor || !gd_compositor->drag)
+		return 0;
+	if (!wp || wp->parent != rootwp || !wp->realized)
+		return gd_compositor->drag(NULL, 0, 0);
+	GsWindowSurface(wp);
+	quiet_dragging = gd_compositor->drag(wp, xoff + wp->bordersize, yoff + wp->bordersize);
+	return quiet_dragging;
+}
+
+/* Whether the screen driver has the frame follow the pointer still (0: no), and where it has
+ * it (2) if it has taken it anywhere. */
+int
+GsDraggedTo(GR_WINDOW_ID wid, int *x, int *y)
+{
+	GR_WINDOW *wp = GsFindWindow(wid);
+	MWCOORD sx = 0, sy = 0;
+	int how;
+
+	if (!wp || !gd_compositor || !gd_compositor->dragged || !(how = gd_compositor->dragged(&sx, &sy)))
+		return 0;
+	if (how == 2) {
+		*x = sx + wp->bordersize;
+		*y = sy + wp->bordersize;
+	}
+	return how;
+}
