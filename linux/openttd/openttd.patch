 {
+#ifdef WITH_SHADEREMU
+	/* No game thread: the progress of a world being made is drawn from here, once a second (a picture is 400,000 instructions). */
+	if (!this->is_game_threaded) {
+		static std::chrono::steady_clock::time_point next;
+		auto now = std::chrono::steady_clock::now();
+		if (!this->HasGUI() || now < next) return;
+		next = now + std::chrono::seconds(1);
+		this->LockVideoBuffer();
+		::UpdateWindows();
+		this->Paint();
+		this->UnlockVideoBuffer();
+		return;
+	}
+#endif
