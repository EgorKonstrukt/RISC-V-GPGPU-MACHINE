+#ifdef SHADEREMU
+/*
+** What a house's team types that are built ahead (IsPrebuilt) ask for of each kind of object,
+** while it is alerted and while it is not. AI_Unit, AI_Vessel and AI_Infantry went through
+** every team type and its members for this, each of them, for every house, every frame; a
+** team type does not change during a scenario. (For a kind, the largest quantity any such
+** team type has of it: what the loops' max() over the members comes to. Infantry's loop also
+** held each count to 5 as it went, which is the same as holding the largest to 5.)
+*/
+struct ShaderEmu_Prebuilt
+{
+    bool HasUnit[2][UNIT_COUNT], HasVessel[2][VESSEL_COUNT], HasInfantry[2][INFANTRY_COUNT];
+    bool AnyUnit[2], AnyVessel[2], AnyInfantry[2];
+    int Unit[2][UNIT_COUNT], Vessel[2][VESSEL_COUNT], Infantry[2][INFANTRY_COUNT];
+};
+
+static const ShaderEmu_Prebuilt& ShaderEmu_Prebuilt_Of(HousesType house)
+{
+    static ShaderEmu_Prebuilt table[HOUSE_COUNT];
+    static char scenario[sizeof(Scen.ScenarioName)];
+    static int types = -1;
+    static unsigned last_frame = ~0u;
+
+    /* (asked sixty times a frame: whether it is still the same scenario is looked at once a frame) */
+    if ((unsigned)Frame == last_frame && types == TeamTypes.Count()) {
+        return table[house];
+    }
+    if (types != TeamTypes.Count() || (unsigned)Frame < last_frame
+        || strncmp(scenario, Scen.ScenarioName, sizeof(scenario) - 1)) {
+        strncpy(scenario, Scen.ScenarioName, sizeof(scenario) - 1);
+        types = TeamTypes.Count();
+        memset(table, 0, sizeof(table));
+        for (int index = 0; index < TeamTypes.Count(); index++) {
+            TeamTypeClass const* team = TeamTypes.Ptr(index);
+            if (team == NULL || !team->IsPrebuilt || (unsigned)team->House >= HOUSE_COUNT) {
+                continue;
+            }
+            ShaderEmu_Prebuilt& t = table[team->House];
+            for (int alerted = team->IsAutocreate ? 1 : 0; alerted < 2; alerted++) {
+                for (int subindex = 0; subindex < team->ClassCount; subindex++) {
+                    TechnoTypeClass const* memtype = team->Members[subindex].Class;
+                    int quantity = team->Members[subindex].Quantity;
+                    switch (memtype->What_Am_I()) {
+                    case RTTI_UNITTYPE: {
+                        int type = ((UnitTypeClass const*)memtype)->Type;
+                        t.Unit[alerted][type] = t.HasUnit[alerted][type] ? max(t.Unit[alerted][type], quantity) : quantity;
+                        t.HasUnit[alerted][type] = true;
+                        t.AnyUnit[alerted] = true;
+                        break;
+                    }
+                    case RTTI_VESSELTYPE: {
+                        int type = ((VesselTypeClass const*)memtype)->Type;
+                        t.Vessel[alerted][type] =
+                            t.HasVessel[alerted][type] ? max(t.Vessel[alerted][type], quantity) : quantity;
+                        t.HasVessel[alerted][type] = true;
+                        t.AnyVessel[alerted] = true;
+                        break;
+                    }
+                    case RTTI_INFANTRYTYPE: {
+                        int type = ((InfantryTypeClass const*)memtype)->Type;
+                        t.Infantry[alerted][type] =
+                            t.HasInfantry[alerted][type] ? max(t.Infantry[alerted][type], quantity) : quantity;
+                        t.HasInfantry[alerted][type] = true;
+                        t.AnyInfantry[alerted] = true;
+                        break;
+                    }
+                    default:
+                        break;
+                    }
+                }
+            }
+        }
+    }
+    last_frame = Frame;
+    return table[house];
+}
+
+/*
+** Whether a house's teams could want any object of a kind at all: a team type built ahead
+** has one, or the house has a team in play. Most houses of a scenario have neither (the
+** player's own, and the dozen that take no part), and for them the counting that follows
+** counted nothing, a thousand instructions a kind a house a frame.
+*/
+static bool ShaderEmu_Teams_Want(HousesType house, const bool* any, bool alerted)
+{
+    if (any[alerted ? 1 : 0]) {
+        return true;
+    }
+    for (int index = 0; index < Teams.Count(); index++) {
+        TeamClass const* tptr = Teams.Ptr(index);
+        if (tptr != NULL && tptr->Class->House == house) {
+            return true;
+        }
+    }
+    return false;
+}
+#endif
+
+/* Whether a house's team types ask nothing of its production now: none built ahead, no team in play. */
+static bool ShaderEmu_Teams_Idle(HousesType house)
+{
+    const ShaderEmu_Prebuilt& ahead = ShaderEmu_Prebuilt_Of(house);
+
+    return !ShaderEmu_Teams_Want(house, ahead.AnyUnit, false) && !ahead.AnyVessel[0] && !ahead.AnyInfantry[0];
+}
