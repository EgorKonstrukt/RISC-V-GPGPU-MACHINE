+/*
+ * The cell of a program's icon in the sheets of icons (tools/make_icons.py), by the name the
+ * kernel has for the process; the cell called "default" for a program with none, else -1.
+ */
+static int
+icon_of(int processid, char *own, int size)
+{
+	/* the index, kept from its first reading: names, and the cell of each */
+	static struct { char name[32]; int cell; } *index;
+	static int index_count = -1, index_default = -1;
+	char path[40], name[32] = "", line[64], known[32], mark[8];
+	int cell, fd, n;
+	FILE *f;
+
+	/* the program's own file first: it may end in its icon (the mark is its last eight bytes) */
+	own[0] = 0;
+	sprintf(path, "/proc/%d/exe", processid);
+	if ((n = readlink(path, own, size - 1)) > 0) {
+		own[n] = 0;
+		if ((fd = open(own, O_RDONLY)) < 0 || lseek(fd, -8, SEEK_END) < 0 || read(fd, mark, 8) != 8 ||
+		    memcmp(mark, "NXICON1", 8) != 0)
+			own[0] = 0;
+		if (fd >= 0)
+			close(fd);
+	} else
+		own[0] = 0;
+	sprintf(path, "/proc/%d/comm", processid);
+	if ((f = fopen(path, "r")) != NULL) {
+		if (!fgets(name, sizeof name, f))
+			name[0] = 0;
+		fclose(f);
+		name[strcspn(name, "\n")] = 0;
+	}
+	if (index_count < 0) {
+		index_count = 0;
+		if ((f = fopen("/usr/share/icons.idx", "r")) != NULL) {
+			int room = 0;
+
+			while (fgets(line, sizeof line, f)) {
+				if (sscanf(line, "%31s %d", known, &cell) != 2)
+					continue;
+				if (index_count == room) {
+					void *more = realloc(index, (room += 64) * sizeof *index);
+
+					if (!more)
+						break;
+					index = more;
+				}
+				strcpy(index[index_count].name, known);
+				index[index_count++].cell = cell;
+				if (!strcmp(known, "default") && index_default < 0)
+					index_default = cell;
+			}
+			fclose(f);
+		}
+	}
+	for (n = 0; n < index_count; n++)
+		if (!strcmp(index[n].name, name))
+			return index[n].cell;
+	return index_default;
+}
 
