+static int SE_HeightmapRows(int z0, int z1) {
+	float hLow, hHigh, height;
+	int hIndex = z0 * World.Width, adjHeight, lowest = World.Height;
+	int x, z;
+
+	for (z = z0; z < z1; z++) {
+		for (x = 0; x < World.Width; x++) {
+			hLow   = CombinedNoise_Calc(se_gen.n1, x * 1.3f, z * 1.3f) / 6 - 4;
+			height = hLow;
+
+			if (OctaveNoise_Calc(se_gen.n3, (float)x, (float)z) <= 0) {
+				hHigh = CombinedNoise_Calc(se_gen.n2, x * 1.3f, z * 1.3f) / 5 + 6;
+				height = max(hLow, hHigh);
+			}
+
+			height *= 0.5f;
+			if (height < 0) height *= 0.8f;
+
+			adjHeight = (int)(height + waterLevel);
