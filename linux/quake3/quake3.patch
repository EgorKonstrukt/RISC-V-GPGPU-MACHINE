+		digits[n++] = '-';
+	}
+	for ( ; at < least - n ; at++ ) {
+		out[at] = ' ';
+	}
+	while ( n ) {
+		out[at++] = digits[--n];
+	}
+	out[at] = 0;
+	return out;
+}
+#endif
