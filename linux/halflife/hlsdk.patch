+	// (two ways a slot, the older of them replaced)
+	static struct { void *model; const char *label; int seq, length; } kept[64][2];
+	static unsigned char older[64];
+	unsigned h = ( (unsigned)(size_t)pmodel * 31u ^ (unsigned)(size_t)label ) >> 2 & 63;
+	for( int w = 0; w < 2; w++ )
