 /* **************************************************************************/
 
+/*
+ * What each character cell shows, kept beside the drawing: every text, fill and copy the
+ * terminal draws goes through the three functions below, which do the same to the cells. The
+ * rows that scroll off the top go to a history, which Shift+Page Up brings back.
+ */
+#define CELL_ROWS	128
+#define CELL_COLS	160
+#define HISTORY_ROWS	400
+static char cells[CELL_ROWS][CELL_COLS];
+static char history[HISTORY_ROWS][CELL_COLS];
+static int history_count;		/* rows ever put in; the newest is at (count - 1) % HISTORY_ROWS */
+static int back;			/* rows scrolled back; 0 shows the live screen */
+static GR_WINDOW_ID live;		/* the live screen's picture while scrolled back */
+static int in_cursor;
+
+static void cell_text(GR_DRAW_ID id, GR_GC_ID gc, GR_COORD x, GR_COORD y, void *str, GR_COUNT count, GR_TEXTFLAGS flags)
+{
+	int r = y / fonh, c = x / fonw, i;
+
+	GrText(id, gc, x, y, str, count, flags);
+	for (i = 0; i < count && r >= 0 && r < CELL_ROWS && c + i < CELL_COLS; i++)
+		cells[r][c + i] = ((char *)str)[i];
+}
+
+static void cell_fill(GR_DRAW_ID id, GR_GC_ID gc, GR_COORD x, GR_COORD y, GR_SIZE w, GR_SIZE h)
+{
+	int r, c;
+
+	GrFillRect(id, gc, x, y, w, h);
+	if (in_cursor)
+		return;		/* the cursor is drawn over a cell, not instead of it */
+	for (r = y / fonh; r < (y + h) / fonh && r < CELL_ROWS; r++)
+		for (c = x / fonw; c < (x + w + fonw - 1) / fonw && c < CELL_COLS; c++)
+			if (r >= 0 && c >= 0)
+				cells[r][c] = 0;
+}
+
+static void cell_copy(GR_DRAW_ID id, GR_GC_ID gc, GR_COORD x, GR_COORD y, GR_SIZE w, GR_SIZE h, GR_DRAW_ID from,
+	GR_COORD fx, GR_COORD fy, unsigned long op)
+{
+	static char moved[CELL_ROWS][CELL_COLS];
+	int r0 = y / fonh, c0 = x / fonw, fr0 = fy / fonh, fc0 = fx / fonw, rows = h / fonh, cols = (w + fonw - 1) / fonw, r;
+
+	GrCopyArea(id, gc, x, y, w, h, from, fx, fy, op);
+	if (rows <= 0 || cols <= 0)
+		return;
+	if (cols > CELL_COLS)
+		cols = CELL_COLS;
+	/* the whole screen moving up: the rows it covers leave for the history */
+	if (r0 == 0 && c0 == 0 && fc0 == 0 && fr0 > 0)
+		for (r = 0; r < fr0 && r < CELL_ROWS; r++)
+			memcpy(history[history_count++ % HISTORY_ROWS], cells[r], CELL_COLS);
+	for (r = 0; r < rows && fr0 + r < CELL_ROWS; r++)
+		memcpy(moved[r], cells[fr0 + r] + fc0, cols < CELL_COLS - fc0 ? cols : CELL_COLS - fc0);
+	for (r = 0; r < rows && r0 + r < CELL_ROWS; r++)
+		memcpy(cells[r0 + r] + c0, moved[r], cols < CELL_COLS - c0 ? cols : CELL_COLS - c0);
+}
+
+static void cell_clear(GR_WINDOW_ID id, int exposeflag)
+{
+	GrClearWindow(id, exposeflag);
+	memset(cells, 0, sizeof cells);
+}
+
+/* For a test: SIGUSR1 writes the screen's text, a line a row after "nxterm|", and where the cursor is. */
+static void sigdump(int sig)
+{
+	char line[CELL_COLS + 48];
+	int r, c, n;
+
+	n = sprintf(line, "nxterm: %d x %d, cursor at %d, %d, wrap %d\n", col, row, curx, cury, wrap);
+	write(2, line, n);
+	for (r = 0; r < row && r < CELL_ROWS; r++) {
+		memcpy(line, "nxterm|", 7);
+		for (n = 7, c = 0; c < col && c < CELL_COLS; c++)
+			line[n++] = cells[r][c] ? cells[r][c] : ' ';
+		while (n > 7 && line[n - 1] == ' ')
+			n--;
+		line[n++] = '\n';
+		write(2, line, n);
+	}
+}
+
+/* One row of the scrolled-back view: history above, the live screen's cells below. */
+static void back_row(int r)
+{
+	int line = r - back, n, kept = history_count < HISTORY_ROWS ? history_count : HISTORY_ROWS;
+	const char *text;
+	char shown[CELL_COLS];
+
+	GrSetGCForeground(gc1, stdbackground);
+	GrFillRect(w1, gc1, 0, r * fonh, winw, fonh);
+	if (line >= 0)
+		text = cells[line];
+	else if (-line <= kept)
+		text = history[(history_count + line) % HISTORY_ROWS];
+	else
+		return;
+	for (n = 0; n < col && n < CELL_COLS; n++)
+		shown[n] = text[n] ? text[n] : ' ';
+	GrSetGCForeground(gc1, stdforeground);
+	GrText(w1, gc1, 0, r * fonh, shown, n, GR_TFTOP);
+}
+
+/* Scrolls the view back by `rows` (forward when negative); at 0 the live screen returns. */
+static void scroll_back(int rows)
+{
+	int kept = history_count < HISTORY_ROWS ? history_count : HISTORY_ROWS, to = back + rows, r;
+
+	if (to > kept)
+		to = kept;
+	if (to < 0)
+		to = 0;
+	if (to == back)
+		return;
+	hide_cursor();
+	if (back == 0) {
+		/* leaving the live screen: keep its picture, colours and all */
+		live = GrNewPixmap(winw, winh, NULL);
+		GrCopyArea(live, gc1, 0, 0, winw, winh, w1, 0, 0, MWROP_COPY);
+	}
+	back = to;
+	if (back == 0) {
+		GrCopyArea(w1, gc1, 0, 0, winw, winh, live, 0, 0, MWROP_COPY);
+		GrDestroyWindow(live);
+		GrSetGCForeground(gc1, gi.foreground);
+		return;
+	}
+	for (r = 0; r < row; r++)
+		back_row(r);
+	/* a mark at the right edge: how far back of all that is kept */
+	GrSetGCForeground(gc1, GR_RGB(96, 96, 96));
+	GrFillRect(w1, gc1, winw - 4, 0, 4, winh);
+	GrSetGCForeground(gc1, GR_RGB(230, 230, 230));
+	r = winh * row / (kept + row);
+	GrFillRect(w1, gc1, winw - 4, (winh - r) * (kept - back) / kept, 4, r);
+	GrSetGCForeground(gc1, gi.foreground);
+}
+
+/*
+ * The desktop's clipboard, a file every program of the desktop reads and writes
+ * (linux/apps/ui.h). Text is selected with the pointer held down, from the cell it went down
+ * on to the cell it is over, row after row as text reads, and is copied when the button is
+ * let go; the right button, Shift+Insert and Ctrl+Shift+V type the clipboard's text. What is
+ * selected is drawn dark on light from the cells kept above, and drawn plain again by the
+ * next key or the next output (its colours, if it had any, are the plain ones after that).
+ */
+#define CLIPBOARD "/tmp/clipboard"
+static int sel_on, sel_held, sel_r0, sel_c0, sel_r1, sel_c1;
+
+/* The window's events, and the pointer's moves with them only while a selection is held: every
+ * move over a window that selects them is an event to answer, and wakes the window system. */
+#define TERM_EVENTS (GR_EVENT_MASK_BUTTON_DOWN | GR_EVENT_MASK_BUTTON_UP | GR_EVENT_MASK_EXPOSURE | \
+	GR_EVENT_MASK_KEY_DOWN | GR_EVENT_MASK_FOCUS_IN | GR_EVENT_MASK_FOCUS_OUT | GR_EVENT_MASK_UPDATE | \
+	GR_EVENT_MASK_CLOSE_REQ)
+
+static void
+sel_moves(int held)
+{
+	static int asked;
+
+	if (asked != held)
+		GrSelectEvents(w1, held ? TERM_EVENTS | GR_EVENT_MASK_MOUSE_MOTION : TERM_EVENTS);
+	asked = held;
+}
+
+/* The cells row r of the window shows now, scrolled back or not; NULL for none. */
+static const char *row_cells(int r)
+{
+	int line = r - back, kept = history_count < HISTORY_ROWS ? history_count : HISTORY_ROWS;
+
+	if (line >= 0)
+		return line < CELL_ROWS ? cells[line] : NULL;
+	return -line <= kept ? history[(history_count + line) % HISTORY_ROWS] : NULL;
+}
+
+/* The selection's ends in reading order. */
+static void sel_ends(int *r0, int *c0, int *r1, int *c1)
+{
+	int forward = sel_r0 < sel_r1 || (sel_r0 == sel_r1 && sel_c0 <= sel_c1);
+
+	*r0 = forward ? sel_r0 : sel_r1, *c0 = forward ? sel_c0 : sel_c1;
+	*r1 = forward ? sel_r1 : sel_r0, *c1 = forward ? sel_c1 : sel_c0;
+}
+
+/* The selected cells drawn as selected, or as plain text again. */
+static void sel_draw(int shown)
+{
+	int r0, c0, r1, c1, r, n;
+	char text[CELL_COLS];
+
+	sel_ends(&r0, &c0, &r1, &c1);
+	for (r = r0; r <= r1; r++) {
+		const char *cellrow = row_cells(r);
+		int from = r == r0 ? c0 : 0, to = r == r1 ? c1 : col - 1;
+
+		if (!cellrow || to < from || from >= CELL_COLS)
+			continue;
+		if (to >= CELL_COLS)
+			to = CELL_COLS - 1;
+		for (n = from; n <= to; n++)
+			text[n - from] = cellrow[n] ? cellrow[n] : ' ';
+		GrSetGCForeground(gc1, shown ? stdforeground : stdbackground);
+		GrFillRect(w1, gc1, from * fonw, r * fonh, (to - from + 1) * fonw, fonh);
+		GrSetGCForeground(gc1, shown ? stdbackground : stdforeground);
+		GrSetGCBackground(gc1, shown ? stdforeground : stdbackground);
+		GrText(w1, gc1, from * fonw, r * fonh, text, to - from + 1, GR_TFTOP);
+	}
+	GrSetGCForeground(gc1, gi.foreground);
+	GrSetGCBackground(gc1, gi.background);
+}
+
+static void sel_drop(void)
+{
+	if (sel_on)
+		sel_draw(0);
+	sel_on = sel_held = 0;
+}
+
+/* The selected text to the clipboard: rows without the blanks at their ends, a newline between. */
+static void sel_copy(void)
+{
+	int r0, c0, r1, c1, r, n;
+	FILE *file = fopen(CLIPBOARD ".new", "wb");
+
+	if (!file)
+		return;
+	sel_ends(&r0, &c0, &r1, &c1);
+	for (r = r0; r <= r1; r++) {
+		const char *cellrow = row_cells(r);
+		int from = r == r0 ? c0 : 0, to = r == r1 ? c1 : col - 1;
+
+		if (to >= CELL_COLS)
+			to = CELL_COLS - 1;
+		while (cellrow && to >= from && (cellrow[to] == 0 || cellrow[to] == ' '))
+			to--;
+		for (n = from; cellrow && n <= to; n++)
+			fputc(cellrow[n] ? cellrow[n] : ' ', file);
+		if (r < r1)
+			fputc('\n', file);
+	}
+	fclose(file);
+	rename(CLIPBOARD ".new", CLIPBOARD);
+}
+
+/* The clipboard's text, typed. */
+static void clip_paste(void)
+{
+	static char text[16384];
+	FILE *file = fopen(CLIPBOARD, "rb");
+	int n, i;
+
+	if (!file)
+		return;
+	n = (int)fread(text, 1, sizeof text, file);
+	fclose(file);
+	for (i = 0; i < n; i++)
+		if (text[i] == '\n')
+			text[i] = '\r';
+	if (n > 0)
+		write(termfd, text, n);
+}
