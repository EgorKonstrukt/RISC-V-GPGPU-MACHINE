 CG_Item
 ==================
 */
+#ifdef SHADEREMU
+/*
+ * The view's four sides, facing in, as the renderer has them (tr_shaderemu.c). An item far
+ * outside one is not made ready and added, where it was added and then not drawn.
+ */
+#define SE_ITEM_REACH	128		/* further from where an item lies than any of its models goes */
+static float	se_sides[4][4];
+
+static void SE_ViewSides( void ) {
+	static float	fov[2], sn[2], cs[2];
+	const float		*o = cg.refdef.vieworg, *f = cg.refdef.viewaxis[0];
+	int				i;
+
+	if ( fov[0] != cg.refdef.fov_x || fov[1] != cg.refdef.fov_y ) {
+		fov[0] = cg.refdef.fov_x, fov[1] = cg.refdef.fov_y;
+		for ( i = 0 ; i < 2 ; i++ ) {
+			sn[i] = sin( fov[i] * ( M_PI / 360.0f ) );
+			cs[i] = cos( fov[i] * ( M_PI / 360.0f ) );
+		}
+	}
+	for ( i = 0 ; i < 4 ; i++ ) {
+		const float	*side = cg.refdef.viewaxis[i < 2 ? 1 : 2];
+		float		s = sn[i >> 1], c = i & 1 ? -cs[i >> 1] : cs[i >> 1], *n = se_sides[i];
+
+		n[0] = f[0] * s + side[0] * c;
+		n[1] = f[1] * s + side[1] * c;
+		n[2] = f[2] * s + side[2] * c;
+		n[3] = DotProduct( o, n );
+	}
+}
+
+static qboolean SE_OutOfView( const vec3_t at, float reach ) {
+	int		i;
+
+	for ( i = 0 ; i < 4 ; i++ ) {
+		if ( DotProduct( at, se_sides[i] ) - se_sides[i][3] < -reach ) {
+			return qtrue;
+		}
+	}
+	return qfalse;
+}
+#endif
