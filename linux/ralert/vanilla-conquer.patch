+/* A sum of the game's state, to see two runs (or two builds) play the same. */
+static void ShaderEmu_State(const char* when)
+{
+    if (ShaderEmu_Occupy_Wrong >= 0) {
+        fprintf(stderr, "ralert: %d cells' occupancy bits were wrong in %d checks of %d cells\n", ShaderEmu_Occupy_Wrong,
