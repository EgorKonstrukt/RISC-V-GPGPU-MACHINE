+
+/* Every store to a cell's OccupierPtr is followed by this; a cell outside the map has no bit. */
+static void Occupied_Set(CELL cell, bool occupied)
+{
+    if ((unsigned)cell >= MAP_CELL_TOTAL) {
+        return;
+    }
+    int x = Cell_X(cell), y = Cell_Y(cell);
+    unsigned* row = &ShaderEmu_Occupied_Rows[y * OCCUPIED_ROW_WORDS + (x >> 5)];
+    unsigned* column = &ShaderEmu_Occupied_Columns[x * OCCUPIED_COLUMN_WORDS + (y >> 5)];
+
+    if (occupied) {
+        *row |= 1u << (x & 31);
+        *column |= 1u << (y & 31);
+    } else {
+        *row &= ~(1u << (x & 31));
+        *column &= ~(1u << (y & 31));
+    }
+}
+
+/* After the cells were written as memory: made anew (all empty), or read from a saved game. */
+void ShaderEmu_Occupied_Rebuild(bool all_empty)
+{
+    memset(ShaderEmu_Occupied_Rows, 0, sizeof(ShaderEmu_Occupied_Rows));
+    memset(ShaderEmu_Occupied_Columns, 0, sizeof(ShaderEmu_Occupied_Columns));
+    for (int cell = 0; !all_empty && cell < MAP_CELL_TOTAL; cell++) {
+        if (Map[(CELL)cell].Cell_Occupier() != NULL) {
+            Occupied_Set((CELL)cell, true);
+        }
+    }
