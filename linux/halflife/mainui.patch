+*/
+
+#include "Framework.h"
+#include "PicButton.h"
+#include "Table.h"
+#include "StringVectorModel.h"
+
+#define ART_BANNER "gfx/shell/head_readme"
+#define WRAP 72	// characters a line: the table's width in the menu's font
+
+class CMenuReadme : public CMenuFramework
+{
+public:
+	CMenuReadme() : CMenuFramework( "CMenuReadme" ) { }
+
+private:
+	void _Init() override;
+
+	CMenuTable text;
+	CStringVectorModel lines;
+};
+
+void CMenuReadme::_Init( void )
+{
+	int length = 0;
+	char *file = (char *)EngFuncs::COM_LoadFile( "readme.txt", &length );
+
+	banner.SetPicture( ART_BANNER );
+	AddItem( banner );
+	AddButton( L( "Done" ), L( "Go back to the Main Menu." ), PC_DONE, VoidCb( &CMenuReadme::Hide ));
+
+	// its lines, tabs as spaces, broken at a space before WRAP characters
+	for( int i = 0; file && i < length; )
+	{
+		char line[WRAP + 1];
+		int n = 0, space = -1;
+
+		while( i < length && file[i] != '\n' && n < WRAP )
+		{
+			char c = file[i++];
+			if( c == '\r' )
+				continue;
+			if( c == '\t' )
+				c = ' ';
+			if( c == ' ' )
+				space = n;
+			line[n++] = c;
+		}
+		if( n == WRAP && i < length && file[i] != '\n' && space > 0 )
+			i -= n - space - 1, n = space;	// (the word that did not fit starts the next line)
+		else if( i < length && file[i] == '\n' )
+			i++;
+		line[n] = 0;
+		lines.AddToTail( CUtlString( line ));
+	}
+	if( file )
+		EngFuncs::COM_FreeFile( file );
+	else lines.AddToTail( CUtlString( L( "Could not find readme.txt" )));
+
+	text.SetupColumn( 0, "Readme.txt", 1.0f );
+	text.SetModel( &lines );
+	text.SetRect( 360, 230, -20, 465 );
+	AddItem( text );
+}
+
+ADD_MENU( menu_readme, CMenuReadme, UI_Readme_Menu );
