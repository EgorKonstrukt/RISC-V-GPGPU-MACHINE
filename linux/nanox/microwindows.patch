+	}
+	if (mousewp != GsFindVisibleWindow(cursorx, cursory))
+		return 0;
+	for (sp = mousewp->children; sp; sp = sp->siblings)
+		if (sp->realized)
+			quiet_cut(p, r, sp->x, sp->y, sp->x + sp->width, sp->y + sp->height);
+	for (wp = mousewp; wp != rootwp; wp = wp->parent) {
