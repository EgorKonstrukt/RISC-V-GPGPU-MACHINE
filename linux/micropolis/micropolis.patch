 /** Initialize the random number generator with a 'random' seed. */
+extern "C" int mp_fixed_seed; // linux/micropolis/engine.cpp: a test's seed, in place of the clock's
+
 void Micropolis::randomlySeedRandom()
 {
+    if (mp_fixed_seed) {
+        seedRandom(mp_fixed_seed);
+        return;
+    }
     struct timeval time;
     gettimeofday(&time, NULL);
     seedRandom(time.tv_usec ^ time.tv_sec);
