+#ifdef WITH_SHADEREMU
+/** A viewport's blit as the first core found it, made later by every core in a band of rows. */
+struct ViewportBlit {
+	const Sprite *sprite;
+	const uint8_t *remap;
+	int x, y;
+	SubSprite sub;
+	bool has_sub;
+	BlitterMode mode;
+	SpriteID sprite_id;
+};
+static std::vector<ViewportBlit> _vp_blits;
+static std::deque<std::array<uint8_t, 3>> _vp_text_remaps; ///< _string_colourremap as each blit had it
+static bool _vp_recording;
+static int _vp_workers = -1;
+
+/** The blits of a viewport's part from here to ViewportBlitsEnd() are kept, not made (OPENTTD_WORKERS=0: made at once). */
+void ViewportBlitsBegin()
+{
+	if (_vp_workers < 0) {
+		const char *asked = getenv("OPENTTD_WORKERS");
+		int want = asked != nullptr ? 0 : 7;
+		for (const char *c = asked; c != nullptr && *c >= '0' && *c <= '9'; c++) want = want * 10 + (*c - '0');
+		_vp_workers = want > 0 && BlitterFactory::GetCurrentBlitter()->GetScreenDepth() == 8 ? mcw_open(want) : 0;
+	}
+	_vp_recording = _vp_workers > 0 && _newgrf_debug_sprite_picker.mode != SPM_REDRAW;
+}
+
+struct ViewportBands {
+	const DrawPixelInfo *dpi;
+	int rows[65]; ///< band k is rows[k] to rows[k + 1], in pixels from the part's top
+	int count;
+};
+
+static void ViewportBlitBand(void *ctx, uint32_t from, uint32_t to)
+{
+	const ViewportBands &bands = *static_cast<const ViewportBands *>(ctx);
+	const DrawPixelInfo &all = *bands.dpi;
+	for (uint32_t k = from; k < to; k++) {
+		DrawPixelInfo d = all;
+		d.top = all.top + ScaleByZoom(bands.rows[k], all.zoom);
+		d.height = ScaleByZoom(bands.rows[k + 1] - bands.rows[k], all.zoom);
+		d.dst_ptr = BlitterFactory::GetCurrentBlitter()->MoveTo(all.dst_ptr, 0, bands.rows[k]);
+		for (const ViewportBlit &b : _vp_blits) {
+			/* (the sprite's rows against the band's, before its clipping is worked out) */
+			int top = b.y + b.sprite->y_offs;
+			if (top >= d.top + d.height || top + b.sprite->height <= d.top) continue;
+			GfxBlitter<ZOOM_BASE, false>(b.sprite, b.x, b.y, b.mode, b.has_sub ? &b.sub : nullptr, b.sprite_id, d.zoom, &d, b.remap);
+		}
+	}
+}
+
+/** The kept blits made into dpi, its rows shared out between the cores; bands meet where no 16 bytes are in both. */
+void ViewportBlitsEnd(const DrawPixelInfo *dpi)
+{
+	if (!_vp_recording) return;
+	_vp_recording = false;
+	ViewportBands bands;
+	bands.dpi = dpi;
+	int rows = UnScaleByZoom(dpi->height, dpi->zoom);
+	int width = UnScaleByZoom(dpi->width, dpi->zoom);
+	int pitch = dpi->pitch;
+	uintptr_t base = reinterpret_cast<uintptr_t>(dpi->dst_ptr);
+	int want = std::min({_vp_workers + 1, rows / 2, 64});
+	if (_vp_blits.size() < 8 || width * rows < 2048) want = 1;
+	bands.count = 0;
+	bands.rows[0] = 0;
+	for (int k = 1; k < want; k++) {
+		int r = std::max(rows * k / want, bands.rows[bands.count] + 1);
+		while (r < rows && (base + (r - 1) * pitch + width - 1) / 16 == (base + r * pitch) / 16) r++;
+		if (r >= rows) break;
+		bands.rows[++bands.count] = r;
+	}
+	bands.rows[++bands.count] = rows;
+	mcw_for_opts opts = {};
+	opts.grain = 1;
+	mcw_for_opt(bands.count, ViewportBlitBand, &bands, &opts);
+	_vp_blits.clear();
+	_vp_text_remaps.clear();
+}
+#endif
+
 static void GfxMainBlitterViewport(const Sprite *sprite, int x, int y, BlitterMode mode, const SubSprite *sub, SpriteID sprite_id)
 {
+#ifdef WITH_SHADEREMU
+	if (_vp_recording) {
+		const uint8_t *remap = _colour_remap_ptr;
+		if (remap == _string_colourremap) {
+			_vp_text_remaps.push_back({_string_colourremap[0], _string_colourremap[1], _string_colourremap[2]});
+			remap = _vp_text_remaps.back().data();
+		}
+		_vp_blits.push_back({sprite, remap, x, y, sub != nullptr ? *sub : SubSprite{}, sub != nullptr, mode, sprite_id});
+		return;
+	}
+#endif
 	GfxBlitter<ZOOM_BASE, false>(sprite, x, y, mode, sub, sprite_id, _cur_dpi->zoom);
 }
 
