+		for (i = 0; i < se_job.count; i++) se_chunks[i]->building = false;
+	}
+}
+
+/* What the worker made becomes the chunks' own. True if any chunk has a mesh from it. */
+static cc_bool SE_Mesh_Collect(void) {
+	struct ChunkInfo* chunk;
+	struct ChunkPartInfo* ptr;
+	struct SEMeshOut* out;
+	cc_bool any = false;
+	int i, k, partsIndex;
+
+	if (!se_running || !mcw_done(1)) return false;
+	se_running = false;
+	for (k = 0; k < se_job.count; k++) {
+		chunk = se_chunks[k];
+		out   = &se_job.out[k];
+		chunk->building = false;
+		/* (a chunk changed since, or one there was no room for, is made another time) */
+		if (!out->made || se_out_serial != se_mesh_serial || !chunk->dirty) continue;
+
+		chunk->allAir = se_job.copy[k].allAir;
+		if (out->verts) {
+			chunk->vb = Gfx_TryCreateStaticVb(VERTEX_FORMAT_TEXTURED, out->verts + 1);
+			if (!chunk->vb) continue;
+			partsIndex = (int)(chunk - mapChunks);
+			for (i = 0; i < MapRenderer_1DUsedCount; i++) {
+				MapRenderer_PartsNormal[partsIndex + i * chunksCount]      = out->norm[i];
+				MapRenderer_PartsTranslucent[partsIndex + i * chunksCount] = out->tran[i];
+			}
+			if (out->hasNorm) chunk->normalParts      = &MapRenderer_PartsNormal[partsIndex];
+			if (out->hasTran) chunk->translucentParts = &MapRenderer_PartsTranslucent[partsIndex];
+			if (out->packed) {
+				Gfx_SE_UnlockPacked(chunk->vb, (struct SEVertex*)out->at, out->verts, out->corner, out->least);
+			} else {
+				Gfx_SE_UnlockFrom(chunk->vb, out->at, VERTEX_FORMAT_TEXTURED, out->verts + 1);
+			}
+		}
+		/* (and BuildChunk's own end) */
+		Game.ChunkUpdates++;
+		se_mesh_chunks++;
+		chunk->dirty  = false;
+		chunk->noData = !chunk->normalParts && !chunk->translucentParts;
+		chunk->empty  = chunk->noData;
+		if (chunk->empty) continue;
+		any = true;
+
+		if (chunk->normalParts) {
+			ptr = chunk->normalParts;
+			for (i = 0; i < MapRenderer_1DUsedCount; i++, ptr += chunksCount) {
+				if (ptr->offset >= 0) normPartsCount[i]++;
+			}
+		}
+		if (chunk->translucentParts) {
+			ptr = chunk->translucentParts;
+			for (i = 0; i < MapRenderer_1DUsedCount; i++, ptr += chunksCount) {
+				if (ptr->offset >= 0) tranPartsCount[i]++;
+			}
+		}
+	}
+	return any;
+}
+
+/* The next chunks that have never had a mesh go to the worker (one that is made again stays
+   the first core's: it is drawn by its old mesh until the new one is there). */
+static void SE_Mesh_Post(void) {
+	struct ChunkInfo* chunk;
+	int i, n = 0;
+
+	if (se_running || !mapChunks || !World.Blocks) return;
+	if (se_workers < 0) {
+		se_workers = getenv("CLASSICUBE_MESH") && !strcmp(getenv("CLASSICUBE_MESH"), "inline") ? 0 : mcw_open(1);
+		if (se_workers > 0) {
+			extern char __DATA_BEGIN__[], _end[];
+			atexit(mcw_close);
+			/* (the worker's copy of the builder is variables nobody has touched: see mcw.h) */
+			mcw_touch(__DATA_BEGIN__, (unsigned)(_end - __DATA_BEGIN__));
+		}
+	}
+	if (se_workers <= 0) return;
+
+	for (i = 0; i < chunksCount && n < SE_MESH_MOST; i++) {
+		chunk = sortedChunks[i];
+		if (chunk->empty || !chunk->dirty || !chunk->noData || distances[i] > (cc_uint32)buildDistSquared) continue;
+		chunk->building = true;
+		se_chunks[n]    = chunk;
+		se_job.copy[n]  = *chunk;
+		se_job.copy[n].normalParts = NULL; se_job.copy[n].translucentParts = NULL;
+		n++;
+	}
+	if (!n) return;
+	se_job.count  = n;
+	se_out_serial = se_mesh_serial;
+	se_running    = true;
+	se_mesh_jobs++;
+	mcw_post(1, Builder_Job_w, (unsigned)&se_job, 0);
+}
