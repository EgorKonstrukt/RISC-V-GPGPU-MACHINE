 #include "cm_polylib.h"
 
 #define	MAX_SUBMODELS			256
+#ifdef SHADEREMU
+/*
+ * A trace marks the brushes and patches it has tested, with a count that goes up a trace, so
+ * that one in several leaves is tested once. The server's traces and the client's game's may
+ * each run on a worker core: a worker has marks and a count of its own (at this file's end).
+ */
+extern int	*se_brush_marks[2], *se_patch_marks[2];
+extern struct se_check_s { int count, unused[3]; } se_worker_checks[2];
+#define CM_Checked( own, number, marks ) SE_Checked( own, number, marks )
+#define CM_NextCheck() SE_NextCheck()
+#endif
+
 #define	BOX_MODEL_HANDLE		255
 #define CAPSULE_MODEL_HANDLE	254
 
@@ -134,6 +146,34 @@ typedef struct {
 #define	SURFACE_CLIP_EPSILON	(0.125)
 
 extern	clipMap_t	cm;
+#ifdef SHADEREMU
+static inline int SE_Checked( int *own, int number, int **marks ) {
+	int		w = SE_OnWorker();
+
+	if ( !w ) {
+		if ( *own == cm.checkcount ) {
+			return 1;
+		}
+		*own = cm.checkcount;
+		return 0;
+	}
+	if ( marks[w - 1][number] == se_worker_checks[w - 1].count ) {
+		return 1;
+	}
+	marks[w - 1][number] = se_worker_checks[w - 1].count;
+	return 0;
+}
+
+static inline void SE_NextCheck( void ) {
+	int		w = SE_OnWorker();
+
+	if ( w ) {
+		se_worker_checks[w - 1].count++;
+	} else {
+		cm.checkcount++;
+	}
+}
+#endif
