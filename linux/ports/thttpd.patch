+static int
+cgi_spawn( httpd_conn* hc )
+    {
+    char** envp;
+    char** argp;
+    char** hargv;
+    char* directory;
+    char* binary;
+    char rest[24];
+    int pre[2] = { -1, -1 };
+    int parse, n, i, a, b;
+    size_t c = 0;
+    pid_t r;
+
+    envp = make_envp( hc );
+    argp = make_argp( hc );
+    if ( argp == (char**) 0 )
+	return -1;
+    if ( hc->method == METHOD_POST && hc->read_idx > hc->checked_idx )
+	{
+	c = hc->read_idx - hc->checked_idx;
+	if ( c > 65536 || pipe( pre ) < 0 )
+	    return -1;
+	(void) httpd_write_fully( pre[1], &(hc->read_buf[hc->checked_idx]), c );
+	(void) close( pre[1] );
+	}
+    (void) my_snprintf( rest, sizeof(rest), "%lld",
+	(long long) ( pre[0] >= 0 && hc->contentlength > c ? hc->contentlength - c : 0 ) );
+    parse = strncmp( argp[0], "nph-", 4 ) != 0 && hc->mime_flag;
+    directory = strdup( hc->expnfilename );
+    binary = directory ? strrchr( directory, '/' ) : (char*) 0;
+    if ( binary != (char*) 0 )
+	*binary++ = '\0';
+    for ( n = 0; argp[n] != (char*) 0; ++n )
+	;
+    hargv = NEW( char*, n + 6 );
+    if ( hargv == (char**) 0 )
+	return -1;
+    hargv[0] = "thttpd";
+    hargv[1] = "-H";
+    hargv[2] = rest;
+    hargv[3] = parse ? "1" : "0";
+    hargv[4] = binary ? binary : hc->expnfilename;
+    for ( i = 0; i <= n; ++i )
+	hargv[5 + i] = argp[i];
+    r = vfork();
+    if ( r == 0 )
+	{
+	/* the child of a vfork: only its own descriptors, then exec */
+	if ( binary != (char*) 0 )
+	    (void) chdir( directory );
+	a = fcntl( hc->conn_fd, F_DUPFD, 10 );
+	b = pre[0] >= 0 ? fcntl( pre[0], F_DUPFD, 10 ) : -1;
+	(void) dup2( a, STDIN_FILENO );
+	(void) dup2( a, STDOUT_FILENO );
+	(void) dup2( a, STDERR_FILENO );
+	if ( b >= 0 )
+	    (void) dup2( b, 3 );
+	else
+	    (void) close( 3 );
+	(void) fexecve( httpd_self_fd, hargv, envp );
+	_exit( 127 );
+	}
+    if ( pre[0] >= 0 )
+	(void) close( pre[0] );
+    free( hargv );
+    free( argp );
+    free( directory );
+    for ( i = 0; envp[i] != (char*) 0; ++i )
+	if ( strcmp( envp[i], "GATEWAY_INTERFACE=CGI/1.1" ) != 0 )
+	    free( envp[i] );
+    return r;
+    }
