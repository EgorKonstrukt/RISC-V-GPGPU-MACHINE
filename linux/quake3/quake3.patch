+#ifdef SHADEREMU
+/*
+ * A token copied or cleared without the kilobyte its string may fill: the text there is, and
+ * what follows the string.
+ */
+static ID_INLINE void TokenCopy(token_t *to, const token_t *from)
+{
+	const char *s = from->string;
+	char *d = to->string;
+
+	while ((*d++ = *s++) != 0)
+		continue;
+	to->type = from->type;
+	to->subtype = from->subtype;
+#ifdef NUMBERVALUE
+	to->intvalue = from->intvalue;
+	to->floatvalue = from->floatvalue;
+#endif
+	to->whitespace_p = from->whitespace_p;
+	to->endwhitespace_p = from->endwhitespace_p;
+	to->line = from->line;
+	to->linescrossed = from->linescrossed;
+	to->next = from->next;
+}
+static ID_INLINE void TokenClear(token_t *token)
+{
+	token->string[0] = 0;
+	memset(&token->type, 0, sizeof(token_t) - offsetof(token_t, type));
+}
+#else
+#define TokenCopy(to, from) Com_Memcpy(to, from, sizeof(token_t))
+#define TokenClear(token) Com_Memset(token, 0, sizeof(token_t))
+#endif
+
