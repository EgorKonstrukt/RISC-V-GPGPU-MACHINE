 	for( int i = 0; i < pstudiohdr->numseq; i++ )
 	{
 		if( stricmp( pseqdesc[i].label, label ) == 0 )
+		{
+#if XASH_SHADEREMU
+			int w = older[h];
+			kept[h][w].model = pmodel, kept[h][w].label = label, kept[h][w].seq = i, older[h] = !w;
